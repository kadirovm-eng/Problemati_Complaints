    <button id="ts-resume" disabled>Продолжить с текущей</button>
    <button id="ts-stop" disabled>Стоп</button>
    <button id="ts-xlsx" disabled>Скачать Excel</button>
    <button id="ts-diag">Диагностика</button>
    <button id="ts-ocrtest">Тест распознавания скрина (1 тикет)</button>
    <button id="ts-cacheclr">Очистить кэш распознавания</button>
    <div id="ts-msg" style="font-size:12px;color:#555"></div>
    <pre id="ts-pre" style="display:none"></pre>`;
  document.body.appendChild(panel);
  const $ = (q) => panel.querySelector(q);
  const msg = (t) => ($('#ts-msg').textContent = t);
  const setStat = (t) => ($('#ts-stat').textContent = t);

  const showPanel = (v) => { S.open = v; panel.style.display = v ? 'block' : 'none'; saveSettings(); };
  launcher.onclick = () => showPanel(panel.style.display === 'none');
  $('#ts-x').onclick = () => showPanel(false);
  showPanel(!!S.open);

  function syncUI() {
    $('#ts-gurl').value = S.gurl || ''; $('#ts-gsecret').value = S.gsecret || ''; $('#ts-ocr').checked = !!S.ocr; $('#ts-hide').checked = !!S.hide; $('#ts-all').checked = !!S.all; $('#ts-badges').checked = !!S.badges; $('#ts-first').checked = !!S.first;
  }
  const changed = () => { saveSettings(); run(); };
  $('#ts-gurl').onchange = (e) => {
    const u = e.target.value.replace(/^[\s"'`]+|[\s"'`]+$/g, '');
    e.target.value = u; S.gurl = u; saveSettings();
    if (!u) msg('Адрес удалён. Распознавание — в браузере.');
    else if (u.split(/[\s,;]+/).filter(Boolean).some((x) => !/^https:\/\/script\.google\.com\/.+\/exec$/.test(x))) msg('⚠ Адрес выглядит неверно: должен начинаться с https://script.google.com/ и заканчиваться на /exec (это адрес «Веб-приложения», а не редактора).');
    else msg('Адрес сохранён (можно указать несколько адресов через пробел — нагрузка поделится между ними). Введите секретное слово и нажмите «Тест распознавания скрина».');
  };
  $('#ts-gsecret').onchange = (e) => { S.gsecret = e.target.value.trim(); saveSettings(); msg('Секретное слово сохранено.'); refreshG(); };
  // сохранение сразу при вводе/вставке (не ждём ухода из поля) + видимый статус под полями
  $('#ts-gsecret').insertAdjacentHTML('afterend', '<div id="ts-gstat" style="font-size:11px;margin-bottom:4px"></div>');
  function refreshG() {
    const ok = !!S.gurl && !!S.gsecret;
    const el = $('#ts-gstat');
    el.style.color = ok ? '#389e0d' : '#cf1322';
    el.textContent = ok ? '✓ адрес и секретное слово сохранены' : (S.gurl ? '⚠ секретное слово не задано' : '⚠ адрес Apps Script не задан — картинки читает слабый движок');
  }
  const cleanU = (v) => String(v || '').replace(/^[\s"'`]+|[\s"'`]+$/g, '');
  if (!IS_LOCKED) $('#ts-gurl').addEventListener('input', (e) => { S.gurl = cleanU(e.target.value); saveSettings(); refreshG(); });
  if (!IS_LOCKED) $('#ts-gsecret').addEventListener('input', (e) => { S.gsecret = String(e.target.value || '').trim(); saveSettings(); refreshG(); });
  refreshG();
  if (IS_LOCKED) { $('#ts-ocrbox').style.display = 'none'; $('#ts-lockednote').style.display = 'block'; }
  $('#ts-ocr').onchange = (e) => { S.ocr = e.target.checked; changed(); };
  $('#ts-hide').onchange = (e) => { S.hide = e.target.checked; changed(); };
  $('#ts-all').onchange = (e) => { S.all = e.target.checked; changed(); msg(S.all ? 'Режим «читать все скриншоты» включён: нажмите «Перепроверить «вручную»» или запустите проверку заново — тикеты без чека на сайте и «сошедшиеся» тоже будут прочитаны Google.' : 'Режим «читать все скриншоты» выключен.'); };
  $('#ts-badges').onchange = (e) => { S.badges = e.target.checked; changed(); };
  $('#ts-first').onchange = (e) => { S.first = e.target.checked; saveSettings(); };

  const results = new Map();   // id -> результат проверки
  let gErr = 0;                // сбои Google (для автоматического снижения параллельности распознавания)
  let apiActive = 0, crawlOn = false;
  let busy = false;            // идёт проверка (не перерисовываем список в это время)
  let running = false;
  let aborted = false;
  let curPageNo = 0;

  const newRes = (row) => ({ id: row.id, error: true, shot: null, ocr: null, n: 0, note: '', page: '', via: '' });

  // итог по тикету: error / none (чеков нет) / ok / review (проверить вручную) / bad (не сошлось, подтверждено)
  const st = (r) => {
    if (r.error) return 'error';
    if (!r.shot || (!r.shot.m && !allMode(r))) return 'none';
    if (!siteSuspect(r)) return 'ok';
    if (allMode(r) && r.shot.sumRes !== 'bad') {                       // режим «все скриншоты»: сайт сумму принял — отмечаем, только если Google ясно видит ДРУГУЮ сумму
      if (!r.ocr || !r.ocr.ok) return r.shot.m ? 'ok' : 'none';
      if (r.ocr.onlyForms || r.ocr.sumFound) return curConflict(r) ? 'review' : 'ok';
      return r.ocr.repeat ? 'bad' : (r.shot.m ? 'ok' : 'none');
    }
    if (S.ocr && r.ocr && r.ocr.onlyForms) return 'ok';
    if (S.ocr && r.ocr && r.ocr.sumFound) return curConflict(r) ? 'review' : 'ok';              // сумма тикета найдена на картинке — расхождение сайта опровергнуто (если не расходится валюта)
    if (!S.ocr || !r.ocr || !r.ocr.ok) return 'review';
    if (isShot(r)) return 'bad';
    if (r.ocr.noAmount && r.shot.sumRes === 'bad') return 'nosum';        // сумма на скриншоте отсутствует — отдельная таблица
    const sumOK = r.shot.sumRes !== 'bad' || r.ocr.sumFound;
    return sumOK ? 'ok' : 'review';
  };
  function reviewReason(r) {
    if (!S.ocr) return 'распознавание картинок выключено';
    if (!r.ocr) return 'ждёт распознавания картинки';
    if (curConflict(r)) return `валюта на чеке (${curSeenText(r)}) не совпадает с валютой тикета (${curCode(r.cur)}) — проверьте вручную`;
    if (!r.ocr.ok) {
      const e = r.ocr.err || 'картинку не удалось прочитать';
      if (/не JSON|HTTP [45]\d\d|too many|rate limit|quota|unavailable|overload|timed? ?out|Timeout|сеть|network|Failed to fetch/i.test(e)) return 'Google не ответил (перегрузка, лимит или неверный адрес скрипта): ' + e;
      if (/не картинка/.test(e)) return 'по ссылке не картинка и не PDF: ' + e;
      if (/слишком больш/.test(e)) return 'файл слишком большой для распознавания: ' + e;
      if (/не распознан/.test(e)) return 'текст на картинке не распознан даже после усиления (размытое, тёмное или обрезанное фото)';
      if (/нет ссылок/.test(e)) return 'в списке нет файлов пользователя';
      return 'не удалось прочитать картинку: ' + e;
    }
    const p = [];
    if (r.shot && r.shot.sumRes === 'bad' && !r.ocr.sumFound) p.push('суммы тикета нет среди прочитанных чисел' + (r.ocr.siteSeen ? '' : ', сумма сайта на картинке тоже не найдена'));
    return 'расхождение не подтверждено картинкой: ' + (p.join('; ') || 'числа не прочитаны уверенно');
  }

  function paint(rows) {
    rows.forEach((r) => {
      const res = results.get(r.id);
      let color = '', badge = '', title = '';
      if (res) {
        const s = st(res);
        color = COLORS[s] || '';
        if (s === 'none' && res.links && !res.links.length) { color = COLORS.nofile; badge = 'нет скриншота'; title = "В User files и Support team's files нет ссылок"; }
        if (s === 'error') { badge = 'ошибка'; title = res.note; }
        else if (s !== 'none') {
          if (res.shot) title = `Чеков распознано сайтом: ${res.shot.m} из ${res.shot.n}; сумма тикета ${res.shot.amount}, по данным сайта на чеке ${res.shot.sums.join(' / ') || '—'} (${SHOT_TXT[res.shot.sumRes]})`;
          if (res.ocr) title += '\nРаспознавание картинки: ' + (res.ocr.ok ? `на чеке (Google): ${(res.ocr.sums || []).join(' / ') || '—'}; сумма тикета ${res.ocr.sumFound ? 'найдена' : 'не найдена'}${res.ocr.siteSeen ? ' (на картинке видна сумма сайта)' : ''}` : 'не удалось (' + res.ocr.err + ')');
          if (s === 'bad') badge = 'суммы тикета нет на скрине';
          else if (s === 'nosum') { badge = 'нет суммы на скрине'; title += '\nНа скриншоте нет суммы (обрезан скрин или показан не тот экран).'; }
          else if (s === 'review') { badge = 'проверить вручную'; title += '\n' + reviewReason(res); }
        }
      }
      r.tCell.style.background = color;
      r.tCell.style.fontWeight = color && res && ['bad', 'review', 'nosum'].includes(st(res)) ? '700' : '';
      r.tCell.title = title;
      if (S.badges && badge) r.tCell.setAttribute('data-tsb', badge); else r.tCell.removeAttribute('data-tsb');
      r.tr.style.display = S.hide && res && ['ok', 'none'].includes(st(res)) ? 'none' : '';
    });
  }
  function counts() {
    const v = [...results.values()].map(st);
    const c = (k) => v.filter((x) => x === k).length;
    return { bad: c('bad'), nosum: c('nosum'), review: c('review'), ok: c('ok'), none: c('none'), error: c('error') };
  }
  function run() {
    const rows = analyze();
    if (!rows) { setStat('Таблица не найдена'); return; }
    paint(rows);
    const c = counts();
    const w = (rows.idx.user < 0 && rows.idx.sup < 0) ? '<div style="color:#d4380d;font-size:12px">⚠ Нет колонки User files (включите её в Column settings) — без неё картинки не распознать</div>' : '';
    $('#ts-stat').innerHTML = `Строк: <b>${rows.length}</b> · к проверке: <b>${rows.filter((r) => !results.has(r.id)).length}</b><br>` +
      `всего проверено: сошлось <b style="color:#389e0d">${c.ok}</b> · не сошлось <b style="color:#cf1322">${c.bad}</b> · нет суммы <b style="color:#d4380d">${c.nosum}</b> · вручную <b style="color:#ad8b00">${c.review}</b> · без чека ${c.none} · ошибок <b>${c.error}</b>${w}`;
  }

  let apiAllFailed = false;
  async function apiPass() {
    const L = analyze();
    if (!L) return;
    const rows = L.filter((r) => !results.has(r.id));
    if (!rows.length) return;
    busy = true; apiActive++;
    let ok = 0, fail = 0, firstErr = '', next = 0;
    const worker = async () => {
      while (!aborted) {
        const row = rows[next++];
        if (!row) return;
        const res = newRes(row);
        res.page = curPageNo || ''; res.via = 'фон'; res.links = row.userLinks || []; res.cur = row.cur || '';
        if (!res.links.length) { res.shot = null; res.n = 0; res.error = false; results.set(row.id, res); ok++; continue; }   // нет файлов — проверять нечего, историю не запрашиваем
        try {
          const entries = await fetchHistoryApi(row.id);
          res.shot = analyzeShots(entries); res.n = entries.length; res.error = false;
          if (!res.cur) res.cur = (entries.find((e) => e.cur) || {}).cur || '';
          ok++;
        } catch (e) { fail++; res.note = e.message; if (!firstErr) firstErr = e.message; }
        results.set(row.id, res);
        setStat(`Запрашиваю историю: ${ok + fail} из ${rows.length}…`);
        await sleep(CFG.apiGapMs);
      }
    };
    await Promise.all(Array.from({ length: CFG.concurrency }, worker));
    apiActive--; busy = false;
    apiAllFailed = ok === 0 && fail > 0;
    run();
    if (apiAllFailed) msg(`История не читается (${firstErr}). Нажмите «Диагностика».`);
    else if (fail > 0) msg(`История получена для ${ok}, не удалось ${fail} (${firstErr}) — см. «Повторить ошибки».`);
  }

  // ---------- фоновая очередь распознавания: идёт параллельно с загрузкой истории и переходом по страницам ----------
  const ocrQ = { workers: 0, active: 0, max: 1, done: 0, okc: 0, errMsg: '', fatal: false, fatalN: 0, okTotal: 0, okRun: 0, lastPaint: 0 };
  const ocrNeeds = (x) => x && !x.error && siteSuspect(x) && (!x.ocr || (x.ocr.retriable && (x.ocrTries || 0) < 3));
  const ocrLeft = () => { let n = 0; for (const x of results.values()) if (ocrNeeds(x) && !x.ocrBusy) n++; return n; };
  const ocrNext = () => { const now = Date.now(); for (const x of results.values()) if (ocrNeeds(x) && !x.ocrBusy && now >= (x.ocrAfter || 0)) return x; return null; };
  async function ocrWorker() {
    while (!aborted && !ocrQ.fatal) {
      if (ocrQ.active >= ocrQ.max) { await sleep(300); continue; }
      const x = ocrNext();
      if (!x) { if (apiActive > 0 || crawlOn || ocrLeft() > 0) { await sleep(400); continue; } return; }
      ocrQ.active++; x.ocrBusy = true;
      const e0 = gErr;
      try {
        x.ocr = (x.links && x.links.length) ? await ocrCheckRow(x, x.links) : { ok: false, err: 'в списке нет ссылок на файлы пользователя' };
      } catch (e) { x.ocr = { ok: false, err: e.message, retriable: true }; }
      x.ocrTries = (x.ocrTries || 0) + 1; x.ocrBusy = false; ocrQ.active--;
      if (x.ocr.retriable) x.ocrAfter = Date.now() + 6000 * x.ocrTries;
      if (x.ocr.fatal) {
        if (ocrQ.fatalN < 6) {                            // раньше Google отвечал нормально → это сбой/перегрузка, а не неверная настройка: ждём и продолжаем
          ocrQ.fatalN++; x.ocr.fatal = false; x.ocr.retriable = true; x.ocrAfter = Date.now() + 15000;
          ocrQ.errMsg = x.ocr.err; ocrQ.max = 1; ocrQ.okRun = 0;
          await sleep(10000);
        } else { ocrQ.fatal = true; ocrQ.errMsg = x.ocr.err; }
      }
      ocrQ.done++;
      if (x.ocr.ok || x.ocr.onlyForms) { ocrQ.okc++; ocrQ.okTotal++; ocrQ.fatalN = 0; } else ocrQ.errMsg = x.ocr.err;
      // адаптивная параллельность: при сбоях Google снижаем, при ровной работе повышаем (до 5)
      if (gErr > e0) { ocrQ.max = Math.max(1, ocrQ.max - 1); ocrQ.okRun = 0; await sleep(3000); }
      else if (++ocrQ.okRun >= 10 && ocrQ.max < 4 * Math.min(4, gUrls().length || 1)) { ocrQ.max++; ocrQ.okRun = 0; }
      if (Date.now() - ocrQ.lastPaint > 1500) { ocrQ.lastPaint = Date.now(); run(); }
      setStat(`Распознаю скриншоты: готово ${ocrQ.done}, в очереди ${ocrLeft()}…`); paintG();
    }
  }
  function kickOcr() {
    if (!S.ocr) return;
    if (ocrQ.fatal && crawlOn) return;                              // фатальная ошибка Google — до конца обхода не повторяем
    if (ocrQ.workers === 0) { ocrQ.fatal = false; ocrQ.done = 0; ocrQ.okc = 0; ocrQ.errMsg = ''; ocrQ.active = 0; ocrQ.max = S.gurl ? 2 * Math.min(4, gUrls().length || 1) : 1; ocrQ.okRun = 0; }
    const need = S.gurl ? 4 * Math.min(4, gUrls().length || 1) : 1;
    while (ocrQ.workers < need) { ocrQ.workers++; ocrWorker().finally(() => { ocrQ.workers--; }); }
  }
  // «добивка»: тикеты, у которых картинку не удалось прочитать из-за сбоев (нагрузка, лимиты), перечитываем ещё раз — медленно, в один поток
  async function ocrSweep() {
    if (aborted || !S.ocr) return;
    for (let round = 0; round < 3 && !aborted && ocrQ.workers === 0 && ocrLeft() > 0; round++) {   // очередь остановилась — до трёх попыток, один поток
      ocrQ.fatal = false; ocrQ.fatalN = 0;
      for (const x of results.values()) if (ocrNeeds(x) && x.ocr) x.ocrTries = 0;
      msg(`Распознавание не дошло до ${ocrLeft()} тикетов — повторяю через несколько секунд (попытка ${round + 1} из 3)…`);
      await sleep(8000 * (round + 1));
      kickOcr(); ocrQ.max = 1; ocrQ.okRun = -1000;
      while (!aborted && ocrQ.workers > 0) await sleep(400);
      run();
    }
    if (!aborted) for (const x of results.values()) if (!x.error && siteSuspect(x) && !x.ocr) x.ocr = { ok: false, err: 'Google не ответил на запросы распознавания (' + String(ocrQ.errMsg || 'нет ответа').slice(0, 100) + ') — нажмите «Перепроверить «вручную»»', retriable: true };
    const redo = [...results.values()].filter((x) => !x.error && ocrQ.workers === 0 && st(x) === 'review' && x.ocr && !x.ocr.ok && x.ocr.err && !x.ocr.onlyForms && !x.ocr.fatal && !/не распознан|нет ссылок|слишком больш/i.test(x.ocr.err));
    if (!redo.length) return;
    msg(`Добиваю тикеты, на которых были сбои чтения: ${redo.length}…`);
    await sleep(8000);
    redo.forEach((x) => { x.ocr = null; x.ocrTries = 0; x.ocrAfter = 0; });
    kickOcr(); ocrQ.max = 1; ocrQ.okRun = -1000;                      // один поток, без повышения
    while (!aborted && ocrQ.workers > 0) await sleep(400);
    run();
  }
  async function ocrDrain() {
    kickOcr();
    while (!aborted && ocrQ.workers > 0) await sleep(400);
    run();
    if (!ocrQ.okc && ocrQ.done) msg(`Распознавание картинок не сработало: ${ocrQ.errMsg}. Скрины не отмечены.`);
  }

  // проверка всех непроверенных тикетов текущей страницы; 'ok' | 'errors' | 'aborted'
  async function checkPage() {
    const L = analyze();
    if (!L) return 'ok';
    await apiPass();
    if (aborted) return 'aborted';
    if (apiAllFailed) return 'errors';
    if (S.ocr) {
      kickOcr();
      if (!crawlOn) { await ocrDrain(); await ocrSweep(); if (aborted) return 'aborted'; }
      else {                                                           // обход: перед переходом на следующую страницу дочитываем спорные тикеты этой (как при проверке одной страницы)
        const t0 = Date.now();
        while (!aborted && ocrQ.workers > 0 && (ocrLeft() > 0 || ocrQ.active > 0) && Date.now() - t0 < 600000) {
          setStat(`Распознаю скриншоты страницы: осталось ${ocrLeft() + ocrQ.active}…`);
          await sleep(400);
        }
        run();
        if (aborted) return 'aborted';
      }
    }
    return 'ok';
  }

  function setRunning(v) {
    running = v;
    ['#ts-run', '#ts-retry', '#ts-redo', '#ts-diag', '#ts-ocrtest', '#ts-crawl'].forEach((q) => { $(q).disabled = v; });
    $('#ts-resume').disabled = v || pagesDone === 0;
    $('#ts-stop').disabled = !v;
    $('#ts-xlsx').disabled = v || results.size === 0;
    panel.querySelectorAll('#ts-sets input').forEach((el) => { el.disabled = v; });
  }

  $('#ts-run').onclick = async () => {
    if (running) return;
    aborted = false; curPageNo = 0; setRunning(true);
    const r = await checkPage();
    run(); setRunning(false);
    if (r === 'errors') return;   // сообщение об ошибке уже в строке статуса
    msg(r === 'aborted' ? 'Остановлено.' : 'Страница проверена.');
  };
  $('#ts-redo').onclick = () => {
    if (running) return;
    let n = 0;
    results.forEach((x) => { if (!x.error && st(x) === 'review') { x.ocr = null; x.ocrTries = 0; x.ocrAfter = 0; n++; } });
    msg(`Перепроверяю «вручную»: ${n}…`);
    run(); $('#ts-run').onclick();
  };
  $('#ts-retry').onclick = () => {
    [...results.entries()].forEach(([id, r]) => { if (r.error) results.delete(id); });
    run(); $('#ts-run').onclick();
  };

  function copy(text) {
    if (typeof GM_setClipboard === 'function') GM_setClipboard(text);
    else navigator.clipboard.writeText(text);
  }
  const LBL = { bad: 'не сошлось', nosum: 'нет суммы', review: 'проверить вручную', error: 'ошибки' };
  ['bad', 'nosum', 'review', 'error'].forEach((k) => {
    $('#ts-c-' + k).onclick = () => {
      const ids = [...results.values()].filter((r) => st(r) === k).map((r) => r.id);
      copy(ids.join('\n'));
      msg(`Скопировано (${LBL[k]}): ${ids.length}`);
    };
  });

  // ---------- обход всех страниц ----------
  const getTotals = () => {
    const m = document.body.innerText.match(/from\s+(\d+)\s+to\s+(\d+)\s+of\s+(\d+)/i);
    return m ? { from: +m[1], to: +m[2], total: +m[3] } : null;
  };
  const signature = () => {
    const t = getTotals();
    const a = analyze();
    return (t ? t.from + '-' + t.to : '') + '|' + (a && a[0] ? a[0].id : '');
  };

  // пагинация ищется по содержимому: ряд элементов вида «‹ 1 … 4 5 6 … 39 ›»
  const PAGER_TEXT = /^(\d+|…|\.{2,3}|[‹›«»<>])?$/;
  const isNum = (el) => /^\d+$/.test((el.innerText || '').trim());
  let pageSize = 0;

  function findPagerBox() {
    if (CFG.pagerSelector) return document.querySelector(CFG.pagerSelector);
    const cands = [...document.querySelectorAll('ul,ol,nav,div')].filter((el) => {
      if (panel.contains(el) || el.closest('#ts-panel,#tn-panel,#th-panel') || el.closest('table')) return false;
      const kids = [...el.children];
      if (kids.length < 4 || kids.length > 25) return false;
      if (!kids.every((k) => PAGER_TEXT.test((k.innerText || '').trim()))) return false;
      return kids.filter(isNum).length >= 3;
    });
    cands.sort((a, b) => a.querySelectorAll('*').length - b.querySelectorAll('*').length);
    return cands[0] || null;
  }

  function getPager() {
    const box = findPagerBox();
    if (!box) return null;
    const items = [...box.children];
    let active = items.find(
      (k) => /active|current|selected/i.test(k.className || '') ||
        k.getAttribute('aria-current') ||
        k.querySelector('.active,.current,.selected,[aria-current]')
    );
    const t = getTotals();
    if (t) pageSize = Math.max(pageSize, t.to - t.from + 1);
    if (!active && t && pageSize) {
      const cur = Math.floor((t.from - 1) / pageSize) + 1;
      active = items.find((k) => (k.innerText || '').trim() === String(cur));
    }
    return { box, items, active };
  }

  // запасной поиск кнопки «далее» по тексту / aria-label / title / rel / классу
  function findNextFallback() {
    const re = /^(›|»|>|next|вперед|вперёд|далее|следующая)$/i;
    const cands = [...document.querySelectorAll('a,button,li,span,[role=button]')].filter((el) => {
      if (panel.contains(el) || el.closest('#ts-panel,#tn-panel,#th-panel') || el.closest('table') || !visible(el)) return false;
      const attrs = [el.getAttribute('aria-label'), el.getAttribute('title'), el.getAttribute('rel')].filter(Boolean).join(' ');
      return re.test((el.innerText || '').trim()) || /(^|\s)next(\s|$)/i.test(attrs) || /(^|[\s_-])next([\s_-]|$)/i.test(el.getAttribute('class') || '');
    });
    return cands.find((el) => !isDisabled(el)) || cands[0] || null;
  }
  function findNext() {
    if (CFG.nextSelector) return document.querySelector(CFG.nextSelector);
    const p = getPager();
    if (!p) return findNextFallback();
    const lastItem = p.items[p.items.length - 1];
    if (!isNum(lastItem)) return lastItem;            // стрелка «›»
    const i = p.items.indexOf(p.active);
    return (i >= 0 && i < p.items.length - 1 ? p.items[i + 1] : null) || findNextFallback();
  }
  function findFirst() {
    const p = getPager();
    if (!p) return null;
    return p.items.find((el) => (el.innerText || '').trim() === '1') || null;
  }
  const isDisabled = (el) =>
    !el || [el, el.querySelector('a,button')].some(
      (n) => n && (n.classList.contains('disabled') || n.getAttribute('aria-disabled') === 'true' || n.hasAttribute('disabled'))
    );
  const clickItem = (el) => (el.querySelector('a,button') || el).click();

  // ждём смены страницы и пока таблица "устаканится"
  async function settle(t0, limit) {
    let prev = signature(), same = 0;
    while (same < 2 && Date.now() - t0 < limit) {
      await sleep(300);
      const cur = signature();
      const n = (analyze() || []).length;
      if (cur === prev && n > 0) same++; else { same = 0; prev = cur; }
    }
    return same >= 2;
  }
  async function waitChange(before, limit) {
    const t0 = Date.now();
    while (Date.now() - t0 < limit) {
      await sleep(300);
      if (signature() !== before) return settle(t0, limit);
    }
    return false;
  }

  // клик с повторами; если страница сменилась с опозданием — повторно не кликаем (чтобы не перескочить страницу)
  async function clickAndWait(getEl) {
    const before = signature();
    for (let attempt = 1; attempt <= CFG.retries; attempt++) {
      if (signature() !== before) { if (await settle(Date.now(), CFG.pageWaitMs)) return 'ok'; }
      const el = getEl();
      if (!el) return 'missing';
      if (isDisabled(el)) return 'disabled';
      clickItem(el);
      if (await waitChange(before, CFG.pageWaitMs * attempt)) return 'ok';
      if (aborted) return 'aborted';
      msg(`Страница долго грузится, повтор ${attempt}/${CFG.retries}…`);
      await sleep(1500);
    }
    return signature() !== before ? 'ok' : 'timeout';
  }


  let visited = new Set();     // «from» каждой пройденной страницы
  let pagesDone = 0;

  function reviewStats() {
    const warn = (S.ocr && !S.gurl && !S.gkey) ? ' ⚠ АДРЕС APPS SCRIPT НЕ ЗАДАН В НАСТРОЙКАХ — картинки читал слабый движок в браузере, поэтому так много «вручную». Впишите адрес и секретное слово в меню «Скрины».' : '';
    const m = {};
    for (const r of results.values()) if (st(r) === 'review') { const k = reviewReason(r).replace(/\d+/g, 'N').slice(0, 70); m[k] = (m[k] || 0) + 1; }
    const top = Object.entries(m).sort((a, b) => b[1] - a[1]).slice(0, 4).map(([k, n]) => `${n}× ${k}`);
    const last = ocrQ.errMsg ? ` Последняя ошибка Google: ${String(ocrQ.errMsg).slice(0, 120)}.` : '';
    return warn + last + (top.length ? ` Причины ручной проверки: ${top.join('; ')}.` : '');
  }
  function coverage() {
    const t = getTotals();
    if (!t || !pageSize) return '';
    const expected = Math.ceil(t.total / pageSize);
    const missing = [];
    for (let i = 1; i <= expected; i++) if (!visited.has((i - 1) * pageSize + 1)) missing.push(i);
    return missing.length
      ? ` ⚠ Пройдено ${expected - missing.length} из ${expected} страниц. Не проверены: ${missing.slice(0, 15).join(', ')}${missing.length > 15 ? '…' : ''}.`
      : ` ✔ Пройдены все ${expected} страниц.`;
  }

  const WHY = {
    missing: 'не найдена кнопка «далее» / блок пагинации (нажмите «Диагностика» и пришлите результат)',
    disabled: 'кнопка «далее» неактивна',
    timeout: `страница не загрузилась после ${CFG.retries} попыток`,
    aborted: 'остановлено кнопкой',
  };


  async function allPages(resume) {
    if (running) return;
    aborted = false;
    if (!resume) { visited = new Set(); pagesDone = 0; }
    setRunning(true);
    let reason = '';
    let note = '';
    try {
      // 1) перейти на первую страницу (не при продолжении)
      if (!resume && S.first) {
        const t = getTotals();
        if (t && t.from > 1) {
          const first = findFirst();
          if (!first) note = 'кнопка «1» не найдена, старт с текущей. ';
          else if (!isDisabled(first)) {
            const r = await clickAndWait(findFirst);
            if (r !== 'ok') note = 'не удалось перейти на 1-ю страницу, старт с текущей. ';
          }
        }
      }

      // 2) обход: на каждой странице проверяем историю всех тикетов нужных статусов; распознавание картинок идёт в фоне параллельно
      crawlOn = true;
      while (!aborted && pagesDone < 1000) {
        run();
        const t = getTotals();
        if (t) { pageSize = Math.max(pageSize, t.to - t.from + 1); visited.add(t.from); }
        pagesDone++;
        curPageNo = pagesDone;
        msg(`Страница ${pagesDone}${t ? ` (${t.to} из ${t.total})` : ''}…`);
        const r = await checkPage();
        if (r === 'errors') { reason = 'история не читается (3 ошибки подряд) — нажмите «Диагностика (1 тикет)»'; break; }
        if (r === 'aborted') break;
        msg(`Страница ${pagesDone} готова · проблемных: ${counts().bad}, ошибок: ${counts().error}`);
        if (t && t.to >= t.total) { reason = 'последняя страница'; break; }
        const nr = await clickAndWait(findNext);
        if (nr !== 'ok') { reason = WHY[nr] || nr; break; }
      }
      crawlOn = false;
      if (S.ocr && !aborted) { msg('Страницы пройдены, дожидаюсь распознавания картинок…'); await ocrDrain(); await ocrSweep(); }
      if (aborted) reason = WHY.aborted;
    } catch (e) {
      crawlOn = false;
      reason = 'ошибка: ' + e.message;
      console.error('[ts]', e);
    }
    busy = false;
    run();
    const c = counts();
    msg(`${note}Конец: ${reason || '—'}. Страниц: ${pagesDone}. Не сошлось: ${c.bad}, нет суммы на скрине: ${c.nosum}, проверить вручную: ${c.review}, ошибок: ${c.error}.${coverage()}${reviewStats()}`);
    setRunning(false);
  }

  $('#ts-resume').onclick = () => allPages(true);
  $('#ts-crawl').onclick = () => allPages(false);
  $('#ts-stop').onclick = () => { aborted = true; };
  $('#ts-cacheclr').onclick = () => { ocrCache.clear(); msg('Кэш распознавания очищен.'); paintG(); };

  // Excel: «Не сошлось» / «Проверить вручную» / «Ошибки»
  $('#ts-xlsx').onclick = () => {
    if (typeof XLSX === 'undefined') { msg('Библиотека XLSX не загрузилась.'); return; }
    const numId = (id) => (/^\d{1,15}$/.test(id) ? Number(id) : id);
    const yn = (b) => (b ? 'да' : 'нет');
    const all = [...results.values()];
    const wb = XLSX.utils.book_new();
    const add = (name, aoa, wch) => {
      const sh = XLSX.utils.aoa_to_sheet(aoa);
      sh['!cols'] = wch.map((w) => ({ wch: w }));
      XLSX.utils.book_append_sheet(wb, sh, name);
    };
    const head = ['ticket_id', 'сумма тикета', 'сумма на чеке (Google)', 'сумма на чеке (по сайту, может быть неверно)', 'сумма', 'чеков распознано', 'скринов всего', 'картинка: сумма найдена', 'текст с картинки (фрагмент)', 'причина', 'page'];
    const line = (r) => [numId(r.id), r.shot.amount, (r.ocr && r.ocr.sums && r.ocr.sums.length ? r.ocr.sums.join(' / ') : '—'), r.shot.sums.join(' / '), SHOT_TXT[r.shot.sumRes], r.shot.m, r.shot.n,
      r.ocr && r.ocr.ok ? yn(r.ocr.sumFound) : '—', r.ocr ? (r.ocr.text || r.ocr.err || '').slice(0, 300) : '',
      st(r) === 'bad' ? 'суммы тикета нет на скрине' : st(r) === 'nosum' ? 'на скриншоте нет суммы (обрезан скрин или показан не тот экран)' : reviewReason(r), r.page];
    const W = [14, 12, 22, 22, 14, 12, 12, 14, 60, 40, 6];
    const bad = all.filter((r) => st(r) === 'bad'), rev = all.filter((r) => st(r) === 'review'), err = all.filter((r) => st(r) === 'error');
    add('Не сошлось', [head, ...bad.map(line)], W);
    const nosum = all.filter((r) => st(r) === 'nosum');
    add('Отсутствует сумма', [head, ...nosum.map(line)], W);
    add('Проверить вручную', [head, ...rev.map(line)], W);
    const nofile = all.filter((r) => !r.error && r.links && !r.links.length);           // в User files и Support team's files нет ссылок
    add('Нет скриншота', [['ticket_id', 'причина', 'page'], ...nofile.map((r) => [numId(r.id), "нет ссылок в User files и Support team's files", r.page])], [14, 50, 6]);
    add('Ошибки', [['ticket_id', 'причина', 'page'], ...err.map((r) => [numId(r.id), r.note, r.page])], [14, 70, 6]);
    const out = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
    const blob = new Blob([out], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'screenshot_check_' + new Date().toISOString().slice(0, 10) + '.xlsx';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    msg(`Excel: не сошлось — ${bad.length}; отсутствует сумма — ${nosum.length}; проверить вручную — ${rev.length}; нет скриншота — ${nofile.length}; ошибок — ${err.length}`);
  };

  // ---------- диагностика: пагинация и данные распознавания сайта (копируется в буфер — пришлите разработчику) ----------
  $('#ts-diag').onclick = async () => {
    if (running) return;
    const L = analyze();
    if (!L) { msg('Таблица не найдена'); return; }
    running = true; busy = true;
    const pg = getPager();
    const nx = findNext();
    const info = {
      pager: { totals: getTotals(), box_found: !!pg, items: pg ? pg.items.map((k) => (k.innerText || '').trim().slice(0, 12)) : null, active: pg && pg.active ? (pg.active.innerText || '').trim() : null,
        next_found: !!nx, next_html: nx ? nx.outerHTML.slice(0, 250) : null, next_disabled: nx ? isDisabled(nx) : null },
      list_columns_index: L.idx, list_headers: [...L.table.querySelectorAll('thead th')].map((x) => norm(txt(x)).slice(0, 25)), rows_in_list: L.length, rows_with_links: L.filter((r) => r.userLinks && r.userLinks.length).length,
      tickets: [],
    };
    for (const r of L.slice(0, 20)) {
      if (info.tickets.length >= 3) break;
      try {
        const j = await fetchHistoryRaw(r.id);
        const arr = findRows(j, ['dateEdit', 'socratResults'], 0) || [];
        if (!arr.some((o) => /receipt/.test(JSON.stringify(o.socratResults || '')))) continue;
        const entries = parseApiHistory(j);
        const sh = analyzeShots(entries);
        const o = arr.find((x) => x.socratResults && JSON.stringify(x.socratResults).length > 4) || arr[0];
        if (!info.history_keys) info.history_keys = Object.keys(arr[0] || {});
        info.tickets.push({ ticket: r.id, ticket_currency_guess: r.cur || (parseApiHistory(j).find((e) => e.cur) || {}).cur || null, links: r.userLinks, analysis: sh, site_suspect: siteSuspect({ shot: sh }), socrat_full: JSON.stringify(o.socratResults).slice(0, 3000) });
      } catch (e) { info.tickets.push({ ticket: r.id, error: e.message }); }
      await sleep(CFG.apiGapMs);
    }
    busy = false; running = false;
    const json = JSON.stringify(info, null, 1);
    console.log('[ts diag]', info);
    copy(json);
    const pre = $('#ts-pre');
    pre.style.display = 'block'; pre.textContent = json;
    msg('Результат диагностики скопирован в буфер — пришлите его.');
    run();
  };

  // ---------- тест распознавания: качаем картинку первого тикета со ссылкой в User files и показываем, что прочитано ----------
  $('#ts-ocrtest').onclick = async () => {
    if (running) return;
    const L = analyze();
    if (!L) { msg('Таблица не найдена'); return; }
    const row = L.find((r) => r.userLinks && r.userLinks.length);
    if (!row) { msg('В списке нет ни одной ссылки на файл пользователя (колонка User files)'); return; }
    running = true; busy = true;
    const info = { ticket: row.id, link: row.userLinks[0] };
    const t0 = Date.now();
    try {
      const url = new URL(row.userLinks[0], location.origin).href;
      const t1 = Date.now();
      const o = await recognizeUrl(url);
      info.engine = o.engine; info.bytes = o.bytes;
      info.seconds = Math.round((Date.now() - t1) / 100) / 10; info.confidence = Math.round(o.conf); info.readable = readable(o);
      info.text = o.text.replace(/\s+/g, ' ').trim().slice(0, 1500);
      info.standalone_numbers = sumCands(o.text, true);
    } catch (e) { info.error = e.message; info.fatal = !!e.fatal; }
    busy = false; running = false;
    const json = JSON.stringify(info, null, 1);
    console.log('[tn ocr test]', info);
    copy(json);
    const pre = $('#ts-pre');
    pre.style.display = 'block'; pre.textContent = json;
    msg(info.error ? 'Распознавание не сработало — результат скопирован в буфер, пришлите его.' : 'Готово. Результат скопирован в буфер — пришлите его.');
    run();
  };

  // ---------- автозапуск при изменении таблицы ----------
  let timer = null;
  new MutationObserver((muts) => {
    if (busy || running || muts.every((m) => panel.contains(m.target) || launcher.contains(m.target))) return;
    clearTimeout(timer);
    timer = setTimeout(run, 400);
  }).observe(document.body, { childList: true, subtree: true });

  syncUI();
  setTimeout(run, 800);
})();
